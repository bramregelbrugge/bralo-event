rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin allowlist: one doc per admin uid, e.g. admins/{uid} = { email: "..." }.
    // Only manageable through the Firebase console / Admin SDK, never from the client.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /tickets/{ticketId} {
        allow read: if isAdmin();
        allow create: if isAdmin();
        allow delete: if false;

        // Allow a scan (valid -> used) or an explicit admin correction.
        // Field-level transitions are intentionally permissive here because every
        // writer must already be an authenticated admin; the 1-scan-per-ticket
        // guarantee is enforced by the client transaction re-checking status
        // inside scanTicket(), not by these rules.
        allow update: if isAdmin();

        match /history/{historyId} {
          allow read: if isAdmin();
          allow create: if isAdmin();
          allow update, delete: if false;
        }
      }
    }
  }
}
